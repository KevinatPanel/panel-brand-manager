# Supabase connection for the client. The publishable (anon) key is safe to ship
# in the browser bundle — Row Level Security protects the data. NEVER put the
# secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional, local dev only: email of a dedicated dev account (created in the Supabase
# dashboard with a numeric password). Enables the "Local dev only" code login, which is
# stripped from production builds. The password/code is NOT stored here.
VITE_DEV_EMAIL=dev@panel.local
